#include <stdlib.h>
#include <string.h>

// Structure to associate the original string with its sorted "anagram key"
typedef struct {
    char* original;
    char* sorted_key;
    int original_index;
} WordPair;

// Function to sort characters within a single string
int compareChars(const void* a, const void* b) {
    return (*(char*)a - *(char*)b);
}

// Function to sort WordPairs alphabetically by their sorted_key
int comparePairs(const void* a, const void* b) {
    return strcmp(((WordPair*)a)->sorted_key, ((WordPair*)b)->sorted_key);
}

char*** groupAnagrams(char** strs, int strsSize, int* returnSize, int** returnColumnSizes) {
    if (strsSize == 0) {
        *returnSize = 0;
        return NULL;
    }

    // 1. Create and populate the WordPair array
    WordPair* pairs = (WordPair*)malloc(strsSize * sizeof(WordPair));
    for (int i = 0; i < strsSize; i++) {
        pairs[i].original = strs[i];
        pairs[i].original_index = i;
        
        // Copy the string and sort its characters to make the key
        int len = strlen(strs[i]);
        pairs[i].sorted_key = (char*)malloc((len + 1) * sizeof(char));
        strcpy(pairs[i].sorted_key, strs[i]);
        qsort(pairs[i].sorted_key, len, sizeof(char), compareChars);
    }

    // 2. Sort the pairs array by their sorted_key
    // This brings all anagrams right next to each other
    qsort(pairs, strsSize, sizeof(WordPair), comparePairs);

    // 3. Allocate memory for the final output tracking
    char*** res = (char***)malloc(strsSize * sizeof(char**));
    *returnColumnSizes = (int*)malloc(strsSize * sizeof(int));
    int groupCount = 0;

    int i = 0;
    while (i < strsSize) {
        int j = i;
        // Find how many matching keys are next to each other
        while (j < strsSize && strcmp(pairs[i].sorted_key, pairs[j].sorted_key) == 0) {
            j++;
        }
        
        int currentGroupSize = j - i;
        res[groupCount] = (char**)malloc(currentGroupSize * sizeof(char*));
        
        // Add all original strings belonging to this anagram group
        for (int k = 0; k < currentGroupSize; k++) {
            res[groupCount][k] = pairs[i + k].original;
        }
        
        (*returnColumnSizes)[groupCount] = currentGroupSize;
        groupCount++;
        
        // Move the loop index to the next unique group key
        i = j;
    }

    *returnSize = groupCount;

    // Free up dynamically allocated key strings
    for (int k = 0; k < strsSize; k++) {
        free(pairs[k].sorted_key);
    }
    free(pairs);

    return res;
}
