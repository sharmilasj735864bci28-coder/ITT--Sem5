int majorityElement(int* nums, int numsSize) {
    int candidate = 0;
    int count = 0;

    for (int i = 0; i < numsSize; i++) {
        // If count falls to 0, pick the current element as our new candidate
        if (count == 0) {
            candidate = nums[i];
        }

        // Increment or decrement the vote tracker
        if (nums[i] == candidate) {
            count++;
        } else {
            count--;
        }
    }

    return candidate;
}
