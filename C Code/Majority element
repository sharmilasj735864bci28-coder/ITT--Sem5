#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* majorityElement(int* nums, int numsSize, int* returnSize) {
    // There can be at most 2 elements that appear more than n/3 times
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 0;

    if (numsSize == 0) {
        return result;
    }

    int candidate1 = 0, candidate2 = 0;
    int count1 = 0, count2 = 0;

    // Step 1: Find potential candidates using Boyer-Moore Voting
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] == candidate1) {
            count1++;
        } else if (nums[i] == candidate2) {
            count2++;
        } else if (count1 == 0) {
            candidate1 = nums[i];
            count1 = 1;
        } else if (count2 == 0) {
            candidate2 = nums[i];
            count2 = 1;
        } else {
            count1--;
            count2--;
        }
    }

    // Step 2: Second pass to explicitly verify candidate counts
    count1 = 0;
    count2 = 0;
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] == candidate1) {
            count1++;
        }
        // Use 'else if' to ensure we don't double count if candidates are identical
        else if (nums[i] == candidate2) {
            count2++;
        }
    }

    // Step 3: Check if verified counts meet the strict threshold (> n / 3)
    int target = numsSize / 3;
    if (count1 > target) {
        result[(*returnSize)++] = candidate1;
    }
    if (count2 > target) {
        result[(*returnSize)++] = candidate2;
    }

    return result;
}
