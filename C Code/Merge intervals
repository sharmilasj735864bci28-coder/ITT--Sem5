#include <stdlib.h>

// Helper function to sort intervals based on their start times
int compareIntervals(const void* a, const void* b) {
    int startA = (*(int**)a)[0];
    int startB = (*(int**)b)[0];
    
    if (startA < startB) return -1;
    if (startA > startB) return 1;
    return 0;
}

int** merge(int** intervals, int intervalsSize, int* intervalsColSize, int* returnSize, int** returnColumnSizes) {
    if (intervalsSize <= 0) {
        *returnSize = 0;
        return NULL;
    }

    // 1. Sort all intervals by their start points
    qsort(intervals, intervalsSize, sizeof(int*), compareIntervals);

    // 2. Allocate initial memory for our output structures
    int capacity = intervalsSize;
    int** merged = (int**)malloc(capacity * sizeof(int*));
    *returnColumnSizes = (int*)malloc(capacity * sizeof(int));
    
    // Add the first interval to our results as the starting reference point
    merged[0] = (int*)malloc(2 * sizeof(int));
    merged[0][0] = intervals[0][0];
    merged[0][1] = intervals[0][1];
    (*returnColumnSizes)[0] = 2;
    int count = 1;

    // 3. Iterate through the remaining intervals and check for overlaps
    for (int i = 1; i < intervalsSize; i++) {
        int currentStart = intervals[i][0];
        int currentEnd = intervals[i][1];
        int lastMergedEnd = merged[count - 1][1];

        // If the current interval overlaps with the previous one
        if (currentStart <= lastMergedEnd) {
            // Merge them by updating the end time of the previous interval if needed
            if (currentEnd > lastMergedEnd) {
                merged[count - 1][1] = currentEnd;
            }
        } else {
            // No overlap, create a new separate row item in our output matrix
            merged[count] = (int*)malloc(2 * sizeof(int));
            merged[count][0] = currentStart;
            merged[count][1] = currentEnd;
            (*returnColumnSizes)[count] = 2;
            count++;
        }
    }

    *returnSize = count;
    return merged;
}
