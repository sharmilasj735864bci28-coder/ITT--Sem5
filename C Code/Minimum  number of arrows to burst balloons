#include <stdlib.h>

// Custom comparison function for qsort
int compareBalloons(const void* a, const void* b) {
    int* balloonA = *(int**)a;
    int* balloonB = *(int**)b;
    
    // Sort by end coordinate in ascending order
    // Using standard conditional comparisons avoids integer underflow/overflow bugs
    if (balloonA[1] < balloonB[1]) return -1;
    if (balloonA[1] > balloonB[1]) return 1;
    return 0;
}

int findMinArrowShots(int** points, int pointsSize, int* pointsColSize) {
    if (pointsSize == 0) {
        return 0;
    }

    // Step 1: Sort the balloons based on their end coordinates
    qsort(points, pointsSize, sizeof(int*), compareBalloons);

    // Track our arrow count and the coordinate of the last shot arrow
    int arrows = 1; // We always need at least one arrow if pointsSize > 0
    int lastArrowPos = points[0][1]; // Shoot the first arrow at the first balloon's end point

    // Step 2: Traverse through the sorted balloons
    for (int i = 1; i < pointsSize; i++) {
        // If the current balloon starts AFTER the last arrow position,
        // it cannot be burst by the previous arrow. We need a new shot!
        if (points[i][0] > lastArrowPos) {
            arrows++;
            lastArrowPos = points[i][1]; // Update our arrow alignment boundary
        }
    }

    return arrows;
}
