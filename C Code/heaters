#include <stdlib.h>
#include <math.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

// Custom comparison function for sorting heaters in ascending order
int compare(const void* a, const void* b) {
    int val1 = *(const int*)a;
    int val2 = *(const int*)b;
    if (val1 < val2) return -1;
    if (val1 > val2) return 1;
    return 0;
}

int findRadius(int* houses, int housesSize, int* heaters, int heatersSize) {
    // Step 1: Sort the heaters to enable Binary Search
    qsort(heaters, heatersSize, sizeof(int), compare);

    int minRadiusStandard = 0;

    // Step 2: Find the nearest heater for each house
    for (int i = 0; i < housesSize; i++) {
        int housePos = houses[i];

        // Binary search to find the first heater >= housePos
        int low = 0;
        int high = heatersSize - 1;
        int idx = heatersSize; // Default index if no heater is >= housePos

        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (heaters[mid] >= housePos) {
                idx = mid;
                high = mid - 1; // Look for a closer heater to the left
            } else {
                low = mid + 1;
            }
        }

        // Distance to the closest heater on the right
        long long distRight = (idx < heatersSize) ? ((long long)heaters[idx] - housePos) : LLONG_MAX;

        // Distance to the closest heater on the left
        long long distLeft = (idx > 0) ? (housePos - (long long)heaters[idx - 1]) : LLONG_MAX;

        // The current house needs a radius that covers the closest available heater
        long long localRadius = MIN(distLeft, distRight);

        // The overall standard radius must satisfy the worst-case house distance
        minRadiusStandard = MAX(minRadiusStandard, localRadius);
    }

    return minRadiusStandard;
}
