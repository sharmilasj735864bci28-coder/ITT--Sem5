#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* intersect(int* nums1, int nums1Size, int* nums2, int nums2Size, int* returnSize) {
    // Array to track the frequency counts of numbers in nums1 (values range 0 to 1000)
    int counts[1001] = {0};
    
    // The maximum possible size of the intersection is the size of the smaller array
    int minSize = (nums1Size < nums2Size) ? nums1Size : nums2Size;
    int* result = (int*)malloc(minSize * sizeof(int));
    *returnSize = 0;
    
    // Step 1: Count occurrences of each number in nums1
    for (int i = 0; i < nums1Size; i++) {
        counts[nums1[i]]++;
    }
    
    // Step 2: Check nums2 against our frequency map
    for (int i = 0; i < nums2Size; i++) {
        int current_val = nums2[i];
        
        // If the element exists and still has remaining available counts
        if (counts[current_val] > 0) {
            result[(*returnSize)++] = current_val;
            counts[current_val]--; // Consume one count occurrence
        }
    }
    
    return result;
}
