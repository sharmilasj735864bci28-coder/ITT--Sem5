#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

// Custom comparison function for qsort
int compareWords(const void* a, const void* b) {
    char* wordA = *(char**)a;
    char* wordB = *(char**)b;
    
    int lenA = strlen(wordA);
    int lenB = strlen(wordB);
    
    // Sort primarily by length descending
    if (lenA != lenB) {
        return lenB - lenA;
    }
    // Sort secondarily by lexicographical order ascending
    return strcmp(wordA, wordB);
}

// Two-pointer helper function to check if 'word' is a subsequence of 's'
bool isSubsequence(const char* word, const char* s) {
    int i = 0, j = 0;
    while (word[i] != '\0' && s[j] != '\0') {
        if (word[i] == s[j]) {
            i++;
        }
        j++;
    }
    return word[i] == '\0'; // Returns true if the entire word was matched
}

char* findLongestWord(char* s, char** dictionary, int dictionarySize) {
    // Step 1: Sort the dictionary with custom multi-level criteria
    qsort(dictionary, dictionarySize, sizeof(char*), compareWords);
    
    // Step 2: Iterate through sorted entries and return the first valid match
    for (int i = 0; i < dictionarySize; i++) {
        if (isSubsequence(dictionary[i], s)) {
            return dictionary[i];
        }
    }
    
    // Step 3: Return an empty string if no dictionary word fits
    return "";
}
