#include <stdlib.h>
#include <string.h>

// Custom comparison function for qsort
int comparePeople(const void* a, const void* b) {
    int* p1 = *(int**)a;
    int* p2 = *(int**)b;
    
    // If heights are different, sort by height in descending order
    if (p1[0] != p2[0]) {
        return p2[0] - p1[0];
    }
    // If heights are the same, sort by k-value in ascending order
    return p1[1] - p2[1];
}

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be malloced, assume caller calls free().
 */
int** reconstructQueue(int** people, int peopleSize, int* peopleColSize, int* returnSize, int** returnColumnSizes) {
    if (peopleSize == 0) {
        *returnSize = 0;
        *returnColumnSizes = NULL;
        return NULL;
    }

    // Step 1: Sort people based on the custom rules (Height desc, k-value asc)
    qsort(people, peopleSize, sizeof(int*), comparePeople);

    // Allocate memory for the final reconstructed queue
    int** queue = (int**)malloc(peopleSize * sizeof(int*));
    *returnColumnSizes = (int*)malloc(peopleSize * sizeof(int));
    *returnSize = 0;

    // Step 2: Insert each person into the queue at the index equal to their k-value
    for (int i = 0; i < peopleSize; i++) {
        int insertIdx = people[i][1];
        
        // Shift elements to the right to make room for the insertion
        for (int j = *returnSize; j > insertIdx; j--) {
            queue[j] = queue[j - 1];
            (*returnColumnSizes)[j] = (*returnColumnSizes)[j - 1];
        }
        
        // Allocate space and place the current person in the slot
        queue[insertIdx] = (int*)malloc(2 * sizeof(int));
        queue[insertIdx][0] = people[i][0];
        queue[insertIdx][1] = people[i][1];
        (*returnColumnSizes)[insertIdx] = 2;
        
        (*returnSize)++;
    }

    return queue;
}
