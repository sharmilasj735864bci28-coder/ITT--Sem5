int findUnsortedSubarray(int* nums, int numsSize) {
    if (numsSize <= 1) {
        return 0;
    }

    int rightBoundary = -1;
    int maxSeenSoFar = nums[0];

    // Step 1: Scan left-to-right to find the rightmost out-of-order element
    for (int i = 1; i < numsSize; i++) {
        if (nums[i] < maxSeenSoFar) {
            rightBoundary = i; // This element should be somewhere to the left
        } else {
            maxSeenSoFar = nums[i];
        }
    }

    // If no elements were out of order, the array is already sorted
    if (rightBoundary == -1) {
        return 0;
    }

    int leftBoundary = 0;
    int minSeenSoFar = nums[numsSize - 1];

    // Step 2: Scan right-to-left to find the leftmost out-of-order element
    for (int i = numsSize - 2; i >= 0; i--) {
        if (nums[i] > minSeenSoFar) {
            leftBoundary = i; // This element should be somewhere to the right
        } else {
            minSeenSoFar = nums[i];
        }
    }

    // Step 3: Compute the length of the window segment
    return rightBoundary - leftBoundary + 1;
}
