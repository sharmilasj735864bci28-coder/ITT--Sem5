#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    int maxArea(vector<int>& height) {
        // Step 1: Initialize opposing pointers
        int left = 0;
        int right = height.size() - 1;
        int max_water = 0;
        
        // Step 2: Loop condition
        while (left < right) {
            // Step 3: Evaluate current state
            int width = right - left;
            int current_height = min(height[left], height[right]);
            int current_area = current_height * width;
            
            // Step 5: Update the maximum answer
            max_water = max(max_water, current_area);
            
            // Step 4: Decision Making - move the shorter pointer inward
            if (height[left] < height[right]) {
                left++;
            } else {
                right--;
            }
        }
        
        return max_water;
    }
};
