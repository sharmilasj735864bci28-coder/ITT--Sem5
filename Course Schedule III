class Solution {
public:
    int scheduleCourse(vector<vector<int>>& courses) {
        // Step 1: Sort courses based on their deadlines (lastDay)
        sort(courses.begin(), courses.end(), [](const vector<int>& a, const vector<int>& b) {
            return a[1] < b[1];
        });
        
        // Max-heap to keep track of the durations of the selected courses
        priority_queue<int> max_heap;
        int time = 0; // Tracks the current day/time
        
        for (const auto& course : courses) {
            int duration = course[0];
            int lastDay = course[1];
            
            // If the course can be completed within its deadline, take it
            if (time + duration <= lastDay) {
                time += duration;
                max_heap.push(duration);
            } 
            // If it doesn't fit, check if we can swap it with a previously taken longer course
            else if (!max_heap.empty() && max_heap.top() > duration) {
                time -= max_heap.top(); // Remove the longest course's duration
                max_heap.pop();
                
                time += duration;       // Add the current shorter course's duration
                max_heap.push(duration);
            }
        }
        
        // The size of the heap represents the maximum number of courses taken
        return max_heap.size();
    }
};
