#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
bool isGreater(int* nums1, int size1, int i, int* nums2, int size2, int j) {
    while (i < size1 && j < size2) {
        if (nums1[i] < nums2[j]) return false;
        if (nums1[i] > nums2[j]) return true;
        i++;
        j++;
    }
    return i < size1; 
}
void maxSubarray(int* nums, int numsSize, int k, int* res) {
    int top = 0;
    int drop = numsSize - k; 
    
    for (int i = 0; i < numsSize; i++) {
        while (top > 0 && res[top - 1] < nums[i] && drop > 0) {
            top--;
            drop--;
        }
        if (top < k) {
            res[top++] = nums[i];
        } else {
            drop--; 
        }
    }
}
void merge(int* sub1, int size1, int* sub2, int size2, int* res) {
    int i = 0, j = 0, r = 0;
    while (i < size1 || j < size2) {
        if (isGreater(sub1, size1, i, sub2, size2, j)) {
            res[r++] = sub1[i++];
        } else {
            res[r++] = sub2[j++];
        }
    }
}
int* maxNumber(int* nums1, int nums1Size, int* nums2, int nums2Size, int k, int* returnSize) {
    *returnSize = k;
    int* ans = (int*)calloc(k, sizeof(int));
    int* candidate = (int*)malloc(k * sizeof(int));
    int min_i = (k - nums2Size > 0) ? k - nums2Size : 0;
    int max_i = (nums1Size < k) ? nums1Size : k;
    int* sub1 = (int*)malloc(k * sizeof(int));
    int* sub2 = (int*)malloc(k * sizeof(int));
    
    for (int i = min_i; i <= max_i; i++) {
        int j = k - i;
        
        maxSubarray(nums1, nums1Size, i, sub1);
        maxSubarray(nums2, nums2Size, j, sub2);
        merge(sub1, i, sub2, j, candidate);
        if (isGreater(candidate, k, 0, ans, k, 0)) {
            memcpy(ans, candidate, k * sizeof(int));
        }
    }
    free(sub1);
    free(sub2);
    free(candidate);
    
    return ans;
}
