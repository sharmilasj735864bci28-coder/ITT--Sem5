#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

char* decodeString(char* s) {
    int max_len = 100005; 
    char* res = (char*)malloc(max_len * sizeof(char));
    int res_len = 0; 
    int count_stack[1000];
    int index_stack[1000];
    int top = 0;

    int i = 0;
    while (s[i] != '\0') {
        if (isdigit(s[i])) {     
            int k = 0;
            while (isdigit(s[i])) {
                k = k * 10 + (s[i] - '0');
                i++;
            }
            count_stack[top] = k;
        } 
        else if (s[i] == '[') {     
            index_stack[top] = res_len;
            top++;
            i++;
        } 
        else if (s[i] == ']') {        
            top--;
            int k = count_stack[top];
            int start_idx = index_stack[top];        
            int sub_len = res_len - start_idx;
            for (int r = 0; r < k - 1; r++) {
                memcpy(&res[res_len], &res[start_idx], sub_len);
                res_len += sub_len;
            }
            i++;
        } 
        else {        
            res[res_len++] = s[i];
            i++;
        }
    }

    res[res_len] = '\0'; 
    return res;
}
