#include <vector>

using namespace std;

class MyCircularQueue {
private:
    vector<int> q;
    int head;
    int tail;
    int capacity;
    int current_size;

public:
    // Initializes the object with the size of the queue to be k.
    MyCircularQueue(int k) {
        capacity = k;
        q.resize(k);
        head = -1;
        tail = -1;
        current_size = 0;
    }
    
    // Inserts an element into the circular queue. Return true if successful.
    bool enQueue(int value) {
        if (isFull()) return false;
        
        if (isEmpty()) {
            head = 0;
        }
        // Wrap around logically using the modulo operator
        tail = (tail + 1) % capacity;
        q[tail] = value;
        current_size++;
        return true;
    }
    
    // Deletes an element from the circular queue. Return true if successful.
    bool deQueue() {
        if (isEmpty()) return false;
        
        if (head == tail) { // Queue had only one element, reset pointers
            head = -1;
            tail = -1;
        } else {
            head = (head + 1) % capacity;
        }
        current_size--;
        return true;
    }
    
    // Gets the front item from the queue. If empty, return -1.
    int Front() {
        if (isEmpty()) return -1;
        return q[head];
    }
    
    // Gets the last item from the queue. If empty, return -1.
    int Rear() {
        if (isEmpty()) return -1;
        return q[tail];
    }
    
    // Checks whether the circular queue is empty or not.
    bool isEmpty() {
        return current_size == 0;
    }
    
    // Checks whether the circular queue is full or not.
    bool isFull() {
        return current_size == capacity;
    }
};

