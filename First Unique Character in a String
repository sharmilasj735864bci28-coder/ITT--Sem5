#include <string>
#include <vector>

using namespace std;

class Solution {
public:
    int firstUniqChar(string s) {
        // Since s consists of only lowercase English letters, a fixed size of 26 is enough
        vector<int> count(26, 0);
        
        // Pass 1: Scan the string to compute character frequencies
        for (char c : s) {
            count[c - 'a']++;
        }
        
        // Pass 2: Find the first character with a frequency count equal to 1
        for (int i = 0; i < s.length(); ++i) {
            if (count[s[i] - 'a'] == 1) {
                return i; // Return the first unique index encountered
            }
        }
        
        return -1; // No unique character found
    }
};
