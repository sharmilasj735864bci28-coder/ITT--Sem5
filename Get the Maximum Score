#include <stdio.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int maxSum(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    long long sum1 = 0;
    long long sum2 = 0;
    long long result = 0;
    int MOD = 1e9 + 7;
    
    int i = 0, j = 0;
    
    while (i < nums1Size && j < nums2Size) {
        if (nums1[i] < nums2[j]) {
            sum1 += nums1[i++];
        } else if (nums1[i] > nums2[j]) {
            sum2 += nums2[j++];
        } else {
            result += MAX(sum1, sum2) + nums1[i];
            sum1 = 0;
            sum2 = 0;
            i++;
            j++;
        }
    }
    while (i < nums1Size) {
        sum1 += nums1[i++];
    }
    while (j < nums2Size) {
        sum2 += nums2[j++];
    }
    result += MAX(sum1, sum2);
    
    return result % MOD;
}
