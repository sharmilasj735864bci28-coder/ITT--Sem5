#include <stack>

using namespace std;

class MyQueue {
private:
    stack<int> input_st;
    stack<int> output_st;

    // Helper method to shift elements when the output stack runs out
    void shiftStacks() {
        if (output_st.empty()) {
            while (!input_st.empty()) {
                output_st.push(input_st.top());
                input_st.pop();
            }
        }
    }

public:
    MyQueue() {
        // Constructor initialization
    }
    
    // Pushes element x to the back of the queue.
    void push(int x) {
        input_st.push(x);
    }
    
    // Removes the element from the front of the queue and returns it.
    int pop() {
        shiftStacks(); // Ensure output_st has elements
        int front_element = output_st.top();
        output_st.pop();
        return front_element;
    }
    
    // Returns the element at the front of the queue.
    int peek() {
        shiftStacks(); // Ensure output_st has elements
        return output_st.top();
    }
    
    // Returns true if the queue is empty, false otherwise.
    bool empty() {
        return input_st.empty() && output_st.empty();
    }
};

