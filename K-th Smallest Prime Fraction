#include <stdlib.h>
int* kthSmallestPrimeFraction(int* arr, int arrSize, int k, int* returnSize) {
    double low = 0.0, high = 1.0;
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 2;
    while (low < high) {
        double mid = low + (high - low) / 2.0;
        int count = 0;
        int p = 0, q = 1;
        double max_fraction = 0.0;
        
        int j = 1;
        for (int i = 0; i < arrSize; i++) {
            while (j < arrSize && arr[i] > mid * arr[j]) {
                j++;
            }
            count += (arrSize - j);
            
          
            if (j < arrSize) {
                double current_fraction = (double)arr[i] / arr[j];
                if (current_fraction > max_fraction) {
                    max_fraction = current_fraction;
                    p = arr[i];
                    q = arr[j];
                }
            }
        }
               if (count == k) {
            result[0] = p;
            result[1] = q;
            return result;
        } else if (count < k) {
            low = mid; 
        } else {
            high = mid; 
        }
    } 
    return result;
}
