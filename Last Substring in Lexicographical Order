#include <string.h>
char* lastSubstring(char* s) {
    int i = 0; 
    int j = 1; 
    int k = 0; 
    
    while (s[j + k] != '\0') {
        if (s[i + k] == s[j + k]) {
            k++;
        } else if (s[i + k] < s[j + k]) {
            i = i + k + 1;
            if (i >= j) {
                j = i + 1;
            }
            k = 0; 
        } else {
            j = j + k + 1;
            k = 0; 
        }
    }
    return s + i;
}
