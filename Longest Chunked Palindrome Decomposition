#include <stdio.h>
#include <string.h>

int longestDecomposition(char* text) {
    int n = strlen(text);
    int left = 0;
    int right = n - 1;
    int count = 0;
    int len = 1; 
    
    while (left <= right) {
        if (left + len - 1 >= right - len + 1) {
            count += 1;
            break;
        }
        int match = 1;
        for (int i = 0; i < len; i++) {
            if (text[left + i] != text[right - len + 1 + i]) {
                match = 0;
                break;
            }
        }
        if (match) {
            count += 2;
            left += len;
            right -= len;
            len = 1;
        } else {
            len++;
        }
    }
    
    return count;
}
