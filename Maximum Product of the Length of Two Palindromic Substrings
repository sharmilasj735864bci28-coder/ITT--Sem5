#include <stdio.h>
#include <stdlib.h>
#include <string.h>
long long maxProduct(char* s) {
    int n = strlen(s);
    if (n < 2) return 0;
    int* P = (int*)calloc(n, sizeof(int));
    int c = 0, r = 0;

    for (int i = 0; i < n; i++) {
        int i_mirror = 2 * c - i;
        if (i < r) {
            P[i] = (r - i < P[i_mirror]) ? (r - i) : P[i_mirror];
        } else {
            P[i] = 0;
        }
        while (i - 1 - P[i] >= 0 && i + 1 + P[i] < n && s[i - 1 - P[i]] == s[i + 1 + P[i]]) {
            P[i]++;
        }
        if (i + P[i] > r) {
            c = i;
            r = i + P[i];
        }
    }
    long long* L = (long long*)calloc(n, sizeof(long long));
    long long* R = (long long*)calloc(n, sizeof(long long));
    for (int i = 0; i < n; i++) {
        int len = 2 * P[i] + 1;
        if (len > L[i + P[i]]) L[i + P[i]] = len;
        if (len > R[i - P[i]]) R[i - P[i]] = len;
    }
    for (int i = n - 2; i >= 0; i--) {
        if (L[i + 1] - 2 > L[i]) {
            L[i] = L[i + 1] - 2;
        }
    }
    for (int i = 1; i < n; i++) {
        if (R[i - 1] - 2 > R[i]) {
            R[i] = R[i - 1] - 2;
        }
    }
    for (int i = 1; i < n; i++) {
        if (L[i - 1] > L[i]) L[i] = L[i - 1];
    }
    for (int i = n - 2; i >= 0; i--) {
        if (R[i + 1] > R[i]) R[i] = R[i + 1];
    }
    long long max_prod = 0;
    for (int i = 0; i < n - 1; i++) {
        long long prod = L[i] * R[i + 1];
        if (prod > max_prod) {
            max_prod = prod;
        }
    }
    free(P);
    free(L);
    free(R);

    return max_prod;
}
