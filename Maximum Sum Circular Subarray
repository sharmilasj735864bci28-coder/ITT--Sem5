#include <vector>
#include <algorithm>
#include <numeric>

using namespace std;

class Solution {
public:
    int maxSubarraySumCircular(vector<int>& nums) {
        int total_sum = 0;
        
        // Track variables for finding maximum subarray (Kadane's)
        int max_sum = nums[0];
        int current_max = 0;
        
        // Track variables for finding minimum subarray
        int min_sum = nums[0];
        int current_min = 0;
        
        for (int x : nums) {
            total_sum += x;
            
            // Standard Kadane's algorithm to find maximum subarray sum
            current_max = max(x, current_max + x);
            max_sum = max(max_sum, current_max);
            
            // Modified Kadane's algorithm to find minimum subarray sum
            current_min = min(x, current_min + x);
            min_sum = min(min_sum, current_min);
        }
        
        // Edge Case: If all elements are negative, total_sum == min_sum.
        // We must return max_sum directly because an empty subarray is invalid.
        if (total_sum == min_sum) {
            return max_sum;
        }
        
        // Return the greater of the non-circular and circular configurations
        return max(max_sum, total_sum - min_sum);
    }
};
