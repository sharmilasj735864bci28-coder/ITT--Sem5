#include <string.h>
void reverse(char* str, int start, int end) {
    while (start < end) {
        char temp = str[start];
        str[start] = str[end];
        str[end] = temp;
        start++;
        end--;
    }
}
void nextPermutation(char* str, int len) {
    int i = len - 2;
    while (i >= 0 && str[i] >= str[i + 1]) {
        i--;
    }
    
    if (i >= 0) {
        int j = len - 1;
        while (str[j] <= str[i]) {
            j--;
        }
        char temp = str[i];
        str[i] = str[j];
        str[j] = temp;
    }
    reverse(str, i + 1, len - 1);
}

int getMinSwaps(char* num, int k) {
    int len = strlen(num);
    char target[len + 1];
    strcpy(target, num);
    for (int i = 0; i < k; i++) {
        nextPermutation(target, len);
    }
    int total_swaps = 0;
    
    for (int i = 0; i < len; i++) {
        if (num[i] != target[i]) {
            int j = i;
            while (num[j] != target[i]) {
                j++;
            }
            while (j > i) {
                char temp = num[j];
                num[j] = num[j - 1];
                num[j - 1] = temp;
                total_swaps++;
                j--;
            }
        }
    }
    
    return total_swaps;
}
