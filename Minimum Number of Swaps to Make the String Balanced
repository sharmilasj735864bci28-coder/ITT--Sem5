#include <string.h>
int minSwaps(char* s) {
    int stack_size = 0;
    int unmatched_close = 0;   
    for (int i = 0; s[i] != '\0'; i++) {
        if (s[i] == '[') {
            stack_size++;
        } else { // s[i] == ']'
            if (stack_size > 0) {
                stack_size--; 
            } else {
                unmatched_close++;
            }
        }
    }
    return (unmatched_close + 1) / 2;
}
