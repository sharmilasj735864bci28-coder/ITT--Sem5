#include <stdlib.h>

char** rotateTheBox(char** boxGrid, int boxGridSize, int* boxGridColSize, int* returnSize, int** returnColumnSizes) {
    int m = boxGridSize;
    int n = boxGridColSize[0];
    for (int r = 0; r < m; r++) {
        int empty_pos = n - 1; 
        for (int c = n - 1; c >= 0; c--) {
            if (boxGrid[r][c] == '*') {
                empty_pos = c - 1;
            } else if (boxGrid[r][c] == '#') {
                char temp = boxGrid[r][c];
                boxGrid[r][c] = boxGrid[r][empty_pos];
                boxGrid[r][empty_pos] = temp;
                empty_pos--;
            }
        }
    }
    char** rotatedBox = (char**)malloc(n * sizeof(char*));
    *returnColumnSizes = (int*)malloc(n * sizeof(int));
    *returnSize = n;
    
    for (int i = 0; i < n; i++) {
        rotatedBox[i] = (char*)malloc(m * sizeof(char));
        (*returnColumnSizes)[i] = m;
    }
    for (int r = 0; r < m; r++) {
        for (int c = 0; c < n; c++) {
            rotatedBox[c][m - 1 - r] = boxGrid[r][c];
        }
    }
    
    return rotatedBox;
}
