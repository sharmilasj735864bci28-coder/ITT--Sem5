#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:
    int intersectionSizeTwo(vector<vector<int>>& intervals) {
        // Step 1: Sort intervals by end ascending, then by start descending
        sort(intervals.begin(), intervals.end(), [](const vector<int>& a, const vector<int>& b) {
            if (a[1] == b[1]) {
                return a[0] > b[0]; 
            }
            return a[1] < b[1];
        });
        
        // Track the two largest elements chosen so far
        int p1 = -1; // Second largest
        int p2 = -1; // Largest
        int ans = 0;
        
        // Step 2: Iterate through the intervals and greedily pick numbers
        for (const auto& interval : intervals) {
            int start = interval[0];
            int end = interval[1];
            
            // Case 1: Zero overlap with the current picked elements
            if (start > p2) {
                ans += 2;
                p1 = end - 1;
                p2 = end;
            } 
            // Case 2: Exactly one overlap (only p2 is within the interval)
            else if (start > p1) {
                ans += 1;
                p1 = p2;
                p2 = end;
            }
            // Case 3: Both p1 and p2 are within the interval (do nothing)
        }
        
        return ans;
    }
};
