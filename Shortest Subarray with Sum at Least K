#include <vector>
#include <deque>
#include <algorithm>
#include <climits>

using namespace std;

class Solution {
public:
    int shortestSubarray(vector<int>& nums, int k) {
        int n = nums.size();
        // Use long long to prevent integer overflow during accumulation
        vector<long long> prefix_sum(n + 1, 0);
        for (int i = 0; i < n; ++i) {
            prefix_sum[i + 1] = prefix_sum[i] + nums[i];
        }
        
        deque<int> dq; // Stores indices of the prefix_sum vector
        int min_len = INT_MAX;
        
        for (int i = 0; i <= n; ++i) {
            // Step 1: Shrink from the front if a valid window is found
            while (!dq.empty() && prefix_sum[i] - prefix_sum[dq.front()] >= k) {
                min_len = min(min_len, i - dq.front());
                dq.pop_front(); // Evict as it cannot yield a shorter valid window later
            }
            
            // Step 2: Maintain a monotonically increasing prefix sum order from the back
            while (!dq.empty() && prefix_sum[i] <= prefix_sum[dq.back()]) {
                dq.pop_back();
            }
            
            // Push the current prefix sum index
            dq.push_back(i);
        }
        
        return min_len == INT_MAX ? -1 : min_len;
    }
};
