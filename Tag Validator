#include <stdbool.h>
#include <string.h>
#include <ctype.h>
#define MAX_STACK_SIZE 500
bool isValidTagName(const char* tag, int len) {
    if (len < 1 || len > 9) return false;
    for (int i = 0; i < len; i++) {
        if (tag[i] < 'A' || tag[i] > 'Z') return false;
    }
    return true;
}
bool isValid(char* code) {
    int n = strlen(code);
    char stack[MAX_STACK_SIZE][10];
    int top = 0; 
    int i = 0;
    while (i < n) {
        if (i > 0 && top == 0) return false;
        if (i + 9 <= n && strncmp(&code[i], "<![CDATA[", 9) == 0) {
            if (top == 0) return false;
            char* cdata_end = strstr(&code[i + 9], "]]>");
            if (!cdata_end) return false;
            i = (cdata_end - code) + 3;
        }
        else if (i + 2 <= n && strncmp(&code[i], "</", 2) == 0) {
            char* tag_end = strchr(&code[i + 2], '>');
            if (!tag_end) return false;
            
            int len = tag_end - (&code[i + 2]);
            if (!isValidTagName(&code[i + 2], len)) return false;
            if (top == 0 || strncmp(stack[top - 1], &code[i + 2], len) != 0 || stack[top - 1][len] != '\0') {
                return false;
            }
            
            top--;
            i = (tag_end - code) + 1;
        }
   
        else if (code[i] == '<') {
            char* tag_end = strchr(&code[i + 1], '>');
            if (!tag_end) return false;
            
            int len = tag_end - (&code[i + 1]);
            if (!isValidTagName(&code[i + 1], len)) return false;           
            if (top >= MAX_STACK_SIZE) return false;
            strncpy(stack[top], &code[i + 1], len);
            stack[top][len] = '\0';
            top++;
            
            i = (tag_end - code) + 1;
        }
        else {
            i++;
        }
    }
    return top == 0;
}
